{
  "name": "vibekit",
  "version": "0.1.0-alpha",
  "description": "VibeKit: spec-driven, multi-agent development for Claude Code and Cursor",
  "type": "module",
  "bin": {
    "vibekit": "bin/vibekit"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "fixtures",
    "scripts",
    "skills",
    "hooks",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:repeat": "node scripts/repeat-tests.js 3",
    "simulate": "node tools/simulate.mjs",
    "recovery": "node tools/recovery.mjs",
    "golden": "node tools/golden.mjs",
    "golden:check": "node tools/golden.mjs --check"
  },
  "license": "MIT",
  "homepage": "https://pershanthenm.github.io/vibekit/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pershanthenm/vibekit.git"
  },
  "bugs": {
    "url": "https://github.com/Pershanthenm/vibekit/issues"
  }
}
